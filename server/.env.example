# Due to breaking changes from spotify, the API is for premium users only now (boo).
# 'Search_Provider' is a new variable that now gives the user the option to search using alternitive methods that are free (e.g. deezer, maybe more later).
# 'deezer' will now be default as it's free, but this can be changed in settings.
SEARCH_PROVIDER=deezer
# Enter your client and secret from your app
# Visit https://developer.spotify.com/documentation/web-api.
# If you're using the alternitive search method you do not have to fill out these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# CORS — set to your domain in production (e.g. https://music.example.com)
# Leave blank or set to * to allow all origins
ALLOWED_ORIGIN=
AUDIO_QUALITY_PRESET=high
AUDIO_FORMAT=mp3
# macOS only: path to a custom CA bundle for yt-dlp (fixes CERTIFICATE_VERIFY_FAILED on corporate/custom CAs)
# Example: YT_DLP_CA_CERT=/path/to/ca-bundle.pem
YT_DLP_CA_CERT=
# Override the download directory (default: <repo-root>/downloads)
# Docker users: set this to match the left side of the volume mount in docker-compose.yml
# Example: DOWNLOAD_PATH=/home/user/music
DOWNLOAD_PATH=
